POSTGRES_DB=encuestas_universitarias
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=6061

JWT_SECRET=cambia-esta-clave-en-produccion
DB_SYNC=true

WEB_PORT=6060
API_PORT=6062

# URL del backend al que llamará el frontend.
# Ejemplo: https://api.tudominio.com/api o http://tu-ip:6062/api
# Si se deja vacio o no se define, usa por defecto /api
VITE_API_URL=

# Origenes permitidos por CORS en la API (usa * para permitir cualquiera o separa por comas)
CORS_ORIGIN=*
